# ── Database: Neon PostgreSQL ──────────────────────────────────────────────
# Runtime connections: use Neon's POOLED connection string.
# pgbouncer=true is required by Prisma behind Neon's PgBouncer (transaction mode).
DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connection_limit=10"

# Schema operations (db push / migrate): use the DIRECT (non-pooler) endpoint.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Admin panel (/?admin=1) ────────────────────────────────────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-strong-password
# openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-random-64-hex-chars

# ── Lead notifications (optional) ──────────────────────────────────────────
# POSTs every new lead as { text, lead } — works with Make.com / n8n / Discord / Slack.
# LEAD_WEBHOOK_URL=
# Optional shared secret sent as "x-lead-secret" header.
# LEAD_WEBHOOK_SECRET=
